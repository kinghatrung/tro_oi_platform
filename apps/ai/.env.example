# Dịch vụ trợ lý AI (apps/ai) — chép thành .env.local
# KHÔNG có MONGODB_URI: AI chỉ đọc dữ liệu qua API công khai của Trọ ơi.

PORT=5300
# API Trọ ơi (apps/api) mà các công cụ gọi qua HTTP
API_BASE_URL=http://localhost:5000
# Web được gọi tới dịch vụ này (CORS), nhiều giá trị cách nhau bởi dấu phẩy
WEB_ORIGIN=http://localhost:3001
# Số proxy đứng trước (nginx trên VPS = 1)
TRUST_PROXY=
# Kho riêng của AI (log hội thoại SQLite: <dir>/chat.db) — production gắn volume
AI_DATA_DIR=data

# ── Model ────────────────────────────────────────────────────────────────────
# mock = model giả để phát triển (không cần key, chỉ hiểu khoảng giá đơn giản)
# openai-compatible = mọi nhà cung cấp có endpoint /chat/completions kiểu OpenAI
#   (Gemini, Groq, OpenRouter, Ollama, ...) — chỉ cần đổi 3 biến dưới
AI_PROVIDER=mock
# vd Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#    Groq:   https://api.groq.com/openai/v1
#    Ollama: http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
