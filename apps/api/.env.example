# =========================================
# MongoDB
# =========================================
MONGODB_URI=mongodb://localhost:27017/tro-oi

# =========================================
# Firebase Admin SDK
# (Lấy từ Firebase Console > Project Settings > Service Accounts > Generate New Private Key)
# =========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =========================================
# JWT
# =========================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# =========================================
# Server
# =========================================
PORT=5000
# CORS — nhiều origin ngăn cách bằng dấu phẩy
WEB_ORIGIN=http://localhost:3001
# URL công khai của API, dùng để tạo link ảnh upload
API_PUBLIC_URL=http://localhost:5000

# =========================================
# Chạy nhiều instance API (bỏ trống = 1 instance, như dev)
# =========================================
# Redis cho chat realtime giữa các instance (Socket.IO redis-adapter)
REDIS_URL=
# Lưu ảnh upload lên dịch vụ tương thích S3 (Cloudflare R2, MinIO, AWS S3). Bỏ trống S3_BUCKET = lưu ổ đĩa apps/api/uploads
S3_BUCKET=
S3_REGION=auto
# Endpoint S3 (R2: https://<account>.r2.cloudflarestorage.com, MinIO: http://localhost:9000). Bỏ trống với AWS S3
S3_ENDPOINT=
# true cho MinIO (đường dẫn dạng endpoint/bucket/key)
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL công khai đọc ảnh (domain public của bucket / CDN), không có / cuối
S3_PUBLIC_URL=

# Bật POST /auth/dev-login (đăng nhập bằng SĐT, không OTP). KHÔNG bật ở production.
AUTH_DEV_LOGIN=false
