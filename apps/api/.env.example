# =========================================
# MongoDB
# =========================================
MONGODB_URI=mongodb://localhost:27017/tro-oi

# =========================================
# Firebase Admin SDK
# (Lấy từ Firebase Console > Project Settings > Service Accounts > Generate New Private Key)
# =========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =========================================
# JWT
# =========================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# =========================================
# Server
# =========================================
PORT=5000
# CORS — nhiều origin ngăn cách bằng dấu phẩy
WEB_ORIGIN=http://localhost:3001
# URL công khai của API, dùng để tạo link ảnh upload
API_PUBLIC_URL=http://localhost:5000

# Bật POST /auth/dev-login (đăng nhập bằng SĐT, không OTP). KHÔNG bật ở production.
AUTH_DEV_LOGIN=false
