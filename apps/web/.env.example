# URL của API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Firebase Client (Phone Auth). Bỏ trống → trang đăng nhập dùng /auth/dev-login (cần AUTH_DEV_LOGIN=true bên API)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL công khai của bucket ảnh khi API bật S3 (= S3_PUBLIC_URL). Bỏ trống nếu ảnh lưu trên API
NEXT_PUBLIC_UPLOAD_URL=
