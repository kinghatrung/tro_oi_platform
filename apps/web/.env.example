# URL của API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Domain công khai của web (canonical, sitemap, og:url). Production: https://room.kun.io.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Dịch vụ trợ lý AI (apps/ai). Production: https://room-api.kun.io.vn/ai
NEXT_PUBLIC_AI_URL=http://localhost:5300

# Firebase Client (Phone Auth). Bỏ trống → trang đăng nhập dùng /auth/dev-login (cần AUTH_DEV_LOGIN=true bên API)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Thông báo đẩy (Firebase Cloud Messaging). Bỏ trống → web ẩn nút bật thông báo đẩy
# Sender ID: Project Settings > General; VAPID key: Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# URL công khai của bucket ảnh khi API bật S3 (= S3_PUBLIC_URL). Bỏ trống nếu ảnh lưu trên API
NEXT_PUBLIC_UPLOAD_URL=

# URL style bản đồ MapLibre (schema OpenMapTiles, vd Vietmap / tile tự host). Bỏ trống = OpenFreeMap
NEXT_PUBLIC_MAP_STYLE_URL=
