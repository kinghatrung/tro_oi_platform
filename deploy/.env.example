# Chép thành /opt/tro-oi/.env trên VPS, điền giá trị, rồi: chmod 600 .env
# Bí mật ngẫu nhiên: openssl rand -hex 32
# Giá trị có ký tự $ thì bọc trong nháy đơn '...' (compose hiểu $ là biến)

# ── Image (điền 1 lần; CI chỉ kéo về) ──────────────────────────────────────────
IMAGE_PREFIX=ghcr.io/kinghatrung
# Ghim SHA commit để quay lại bản cũ của 1 service, vd API_TAG=3f2a1bc…  (mặc định: latest)
API_TAG=latest
WEB_TAG=latest
AI_TAG=latest
# Biến model của trợ lý AI nằm ở file riêng ai.env (xem ai.env.example), không đặt ở đây

# ── API ─────────────────────────────────────────────────────────────────────────
MONGODB_URI=
WEB_ORIGIN=https://room.kun.io.vn
API_PUBLIC_URL=https://room-api.kun.io.vn
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_DEV_LOGIN=false

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nháy kép và các \n như trong file JSON service account
FIREBASE_PRIVATE_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=log

# Tuỳ chọn: lưu ảnh lên S3/R2 thay cho volume "uploads" (khi đó đặt cả biến GitHub NEXT_PUBLIC_UPLOAD_URL)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
