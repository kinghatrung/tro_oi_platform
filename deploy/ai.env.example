# Chép thành /opt/tro-oi/ai.env trên VPS, điền giá trị, rồi: chmod 600 ai.env
# File riêng cho trợ lý AI — KHÔNG đưa biến của API (MONGODB_URI, JWT_SECRET...) vào đây.
# Các biến PORT, API_BASE_URL, WEB_ORIGIN, TRUST_PROXY, AI_DATA_DIR đã đặt trong docker-compose.yml.

# mock = model giả (không cần key); openai-compatible = Gemini, Groq, OpenRouter, Ollama...
AI_PROVIDER=openai-compatible
# vd Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
# Nhiều model cách nhau bởi dấu phẩy: model đầu lỗi / quá tải → thử model sau
AI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
